{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=MehfuzDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": ""
  },
  "AdminSeed": {
    "Email": "admin@mehfuzdryfruits.com",
    "Password": ""
  },
  "ClientOrigins": "http://localhost:5173",
  "UploadDir": "",
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Forwarded-For",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "post:/api/auth/login",
        "Period": "15m",
        "Limit": 20
      },
      {
        "Endpoint": "post:/api/orders",
        "Period": "15m",
        "Limit": 30
      }
    ]
  }
}
