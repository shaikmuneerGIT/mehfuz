# Copy this to `.env` on the VPS (same directory as docker-compose.yml)
# and fill in real values. docker-compose reads it automatically.
# NEVER commit the real .env to git.

# Generate with: openssl rand -hex 48
JWT_SECRET=change_me

# Admin dashboard login (/admin/login)
ADMIN_EMAIL=admin@mehfuzdryfruits.com
ADMIN_PASSWORD=change_me

# Your domain, once you have one. Comma-separate if you serve both the
# apex and www. Until then this can be the VPS's IP address.
CLIENT_ORIGIN=https://mehfuz.com,https://www.mehfuz.com
