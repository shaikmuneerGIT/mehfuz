DATABASE_URL="file:./dev.db"

# Required. Generate a strong random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change_me"

PORT=4000

# Seed credentials for the admin dashboard. Change before deploying.
ADMIN_EMAIL="admin@mehfuzdryfruits.com"
ADMIN_PASSWORD="change_me"

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN="http://localhost:5173"

# Set to "true" when running behind a reverse proxy so rate limiting sees
# the real client IP rather than the proxy's.
TRUST_PROXY=false
